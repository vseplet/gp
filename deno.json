{
  "name": "@gp/git-profiles",
  "version": "0.2.1",
  "exports": "./src/mod.ts",
  "tasks": {
    "dev": "deno run --allow-read --allow-write --allow-run --allow-env src/mod.ts",
    "install": "deno install -g -n gp --allow-read --allow-write --allow-run --allow-env src/mod.ts",
    "test": "deno test --allow-read --allow-write --allow-run --allow-env",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "check": "deno check src/mod.ts"
  },
  "imports": {
    "@cliffy/command": "jsr:@cliffy/command@1.0.0-rc.7",
    "@cliffy/prompt": "jsr:@cliffy/prompt@1.0.0-rc.7",
    "@std/path": "jsr:@std/path@1",
    "@std/assert": "jsr:@std/assert@1",
    "@/": "./src/"
  }
}
